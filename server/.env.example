# ── Database (matches docker-compose.yml defaults) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=schedule_management
POSTGRES_SCHEMA=public

# ── Redis (matches docker-compose.yml defaults) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here

# ── AI ────────────────────────────────────────────────────────────────────────
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── Embedding ────────────────────────────────────────────────────────────────
# 本地 embedding（bge-small-zh-v1.5，原生 512 維）：無配額、無網路依賴。
# 啟用步驟：
#   1. pip install sentence-transformers
#   2. EMBEDDING_LOCAL=1
#   3. python reembed_all.py && python reindex_all_embeddings.py（統一向量空間，必跑）
# EMBEDDING_LOCAL=1
# EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
# 雲端備援（沒設的自動跳過）：
# JINA_API_KEY=
# VOYAGE_API_KEY=
# COHERE_API_KEY=

# ── Maps ──────────────────────────────────────────────────────────────────────
HERE_API_KEY=your_here_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Firebase (FCM push notifications) ────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json
